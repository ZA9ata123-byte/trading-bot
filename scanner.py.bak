"""
scanner.py — الذئب المنفرد 🐺 ضرب وهرب!
═══════════════════════════════════════════
الاستراتيجية الرابحة:
1. نلقاو Top Gainers (عملات طالعة +3%)
2. ننتظرو RSI ينزل لـ 30 على 1m (تصحيح)
3. ندخلو → 5 pips → نخرجو!
عملة صاعدة + RSI منخفض = الذهب!
"""
import pandas as pd, numpy as np, logging, requests, time
log = logging.getLogger(__name__)
from config import *


def calculate_rsi(series, period=14):
    delta = series.diff()
    gain = delta.where(delta > 0, 0)
    loss = -delta.where(delta < 0, 0)
    avg_gain = gain.ewm(com=period-1, min_periods=period).mean()
    avg_loss = loss.ewm(com=period-1, min_periods=period).mean()
    rs = avg_gain / avg_loss.replace(0, 1)
    return 100 - (100 / (1 + rs))


def get_price_tier(price):
    for k, t in PRICE_TIERS.items():
        if t['min_price'] <= price <= t['max_price']:
            return {**t, "tier_key": k}
    return {"tier_key": "DEFAULT", "tp_pct": TP_PCT, "sl_pct": SL_PCT,
            "min_volume": MIN_VOLUME_USD, "name": "عادية"}


# ═══════════════════════════════════════════════════════════
# 1️⃣ مسح Top Gainers — عملات صاعدة فقط!
# ═══════════════════════════════════════════════════════════
def get_top_gainers(exchange):
    """نجمعو غير العملات اللي طالعة — Top Gainers!"""
    try:
        tickers = exchange.fetch_tickers()
        coins = []
        for symbol, t in tickers.items():
            if not symbol.endswith("/USDT"):
                continue
            base = symbol.split("/")[0]
            if any(base.endswith(x) for x in
                   ['UP', 'DOWN', 'BULL', 'BEAR', '3L', '3S', '5L', '5S']):
                continue

            price  = t.get('last', 0) or 0
            change = t.get('percentage', 0) or 0
            volume = t.get('quoteVolume', 0) or 0
            tier   = get_price_tier(price)

            # ═══ الفلتر الأساسي: Top Gainer + تحت $0.05 ═══
            if (MIN_PRICE < price <= MAX_PRICE and
                MIN_CHANGE_PCT <= change <= MAX_CHANGE_PCT and
                volume >= tier.get('min_volume', MIN_VOLUME_USD)):
                coins.append({
                    "symbol": symbol,
                    "price": price,
                    "change": change,
                    "volume": volume,
                    "tier": tier.get('tier_key', 'DEFAULT'),
                })

        # ترتيب حسب الأكثر صعوداً × الحجم
        coins.sort(key=lambda x: x['change'] * x['volume'], reverse=True)
        top = coins[:TOP_GAINERS]

        if top:
            log.info(f"🔍 {len(top)} Top Gainer من {len(coins)} مؤهلة")
        return top

    except Exception as e:
        log.error(f"خطأ Scanner: {e}")
        return []


# ═══════════════════════════════════════════════════════════
# 2️⃣ RSI على 1m — ننتظرو التصحيح!
# ═══════════════════════════════════════════════════════════
def check_rsi_1m(exchange, symbol):
    """RSI على فريم 1 دقيقة — قلب الاستراتيجية"""
    try:
        ohlcv = exchange.fetch_ohlcv(symbol, "1m", limit=30)
        df = pd.DataFrame(ohlcv, columns=['t', 'open', 'high', 'low', 'close', 'volume'])
        df['rsi'] = calculate_rsi(df['close'], RSI_PERIOD)
        df['vol_avg'] = df['volume'].rolling(10).mean()

        last = df.iloc[-1]
        prev = df.iloc[-2]
        rsi = last['rsi']
        rsi_prev = prev['rsi']
        price = last['close']
        vol_ratio = last['volume'] / last['vol_avg'] if last['vol_avg'] > 0 else 1

        # شكل الشمعة
        body = last['close'] - last['open']
        total_range = last['high'] - last['low']
        bullish = body > 0
        strong_bullish = body > 0 and total_range > 0 and body > total_range * 0.6
        bearish_candle = (last['close'] < last['open'] and total_range > 0
                          and abs(body) > total_range * 0.5)

        # ارتداد RSI
        rsi_bounce = rsi > rsi_prev and rsi_prev < RSI_BUY + 5
        rsi_cross30 = rsi_prev < 30 and rsi >= 30

        # ═══ النقاط ═══
        score = 0
        if rsi < 30:        score += 35
        elif rsi < RSI_BUY: score += 25
        elif rsi < 45:      score += 10

        if rsi_bounce:      score += 20
        if rsi_cross30:     score += 15
        if strong_bullish:  score += 15
        elif bullish:       score += 8
        if vol_ratio >= 1.5: score += 10

        # عقوبات
        if rsi > RSI_SELL:  score -= 30
        elif rsi > 55:      score -= 15
        if bearish_candle:  score -= 10

        ok = score >= 40 and rsi < RSI_BUY + 10

        return {
            "ok": ok, "score": score, "rsi": round(rsi, 1),
            "rsi_prev": round(rsi_prev, 1), "vol_ratio": round(vol_ratio, 2),
            "bullish": bullish, "bounce": rsi_bounce, "price": price,
            "bearish_candle": bearish_candle,
        }

    except Exception as e:
        log.debug(f"خطأ RSI {symbol}: {e}")
        return {"ok": False, "score": 0, "rsi": 50, "bearish_candle": False}


# ═══════════════════════════════════════════════════════════
# 3️⃣ الترند — 15m + 1h (بحال v4 الأصلي!)
# ═══════════════════════════════════════════════════════════
def check_trend(exchange, symbol):
    """الترند على 15m + 1h — خصهم الاثنين صاعدين"""
    try:
        total = 0
        for tf in ["15m", "1h"]:
            ohlcv = exchange.fetch_ohlcv(symbol, tf, limit=50)
            df = pd.DataFrame(ohlcv, columns=['t', 'open', 'high', 'low', 'close', 'volume'])
            df['ma7'] = df['close'].rolling(7).mean()
            df['ma25'] = df['close'].rolling(25).mean()
            df['rsi'] = calculate_rsi(df['close'])
            last = df.iloc[-1]

            s = 0
            if last['ma7'] > last['ma25']: s += 25
            if 35 < last['rsi'] < 70:     s += 20
            if last['close'] > last['ma7']: s += 15
            if last['close'] > last['open']: s += 10
            if last['rsi'] > 75:           s -= 20
            total += s

        avg = total / 2
        return {"ok": avg >= TREND_MIN_SCORE, "score": round(avg, 1)}

    except:
        return {"ok": False, "score": 0}


# ═══════════════════════════════════════════════════════════
# 4️⃣ الشموع اليابانية — 5m
# ═══════════════════════════════════════════════════════════
def check_candles(exchange, symbol):
    try:
        ohlcv = exchange.fetch_ohlcv(symbol, "5m", limit=10)
        df = pd.DataFrame(ohlcv, columns=['t', 'open', 'high', 'low', 'close', 'volume'])
        last = df.iloc[-1]
        prev = df.iloc[-2]
        o, h, l, c = last['open'], last['high'], last['low'], last['close']
        body = abs(c - o)
        total = h - l
        patterns = []
        bullish = False

        if (c > o and prev['close'] < prev['open'] and
                c > prev['open'] and o < prev['close']):
            patterns.append("Engulfing 🟢"); bullish = True

        lower_wick = min(o, c) - l
        if total > 0 and lower_wick > body * 2:
            patterns.append("Hammer 🔨"); bullish = True

        if c > o and total > 0 and body > total * 0.7:
            patterns.append("صاعدة 💪"); bullish = True

        upper_wick = h - max(o, c)
        if total > 0 and upper_wick > body * 2 and c < o:
            patterns.append("مشنوق ☠️")

        if c < o and total > 0 and body > total * 0.7:
            patterns.append("هابطة ⚠️")

        return {"patterns": patterns or ["عادية"], "bullish": bullish}
    except:
        return {"patterns": ["خطأ"], "bullish": False}


# ═══════════════════════════════════════════════════════════
# 5️⃣ المقاومة
# ═══════════════════════════════════════════════════════════
def check_resistance(exchange, symbol):
    try:
        ohlcv = exchange.fetch_ohlcv(symbol, "15m", limit=50)
        df = pd.DataFrame(ohlcv, columns=['t', 'open', 'high', 'low', 'close', 'volume'])
        price = df.iloc[-1]['close']
        high20 = df['high'].rolling(20).max().iloc[-1]
        near = abs(price - high20) / price < 0.015
        return {"near_resist": near, "resistance": round(high20, 8)}
    except:
        return {"near_resist": False}


# ═══════════════════════════════════════════════════════════
# 🔍 المسح الكامل — ضرب وهرب!
# ═══════════════════════════════════════════════════════════
def scan_all(exchange, blacklist={}, open_trades=None):
    """
    المنطق الرابح:
    Top Gainer → RSI نزل → Trend صاعد → ندخلو!
    """
    if open_trades is None:
        open_trades = []
    coins = get_top_gainers(exchange)
    open_symbols = {t.get("symbol") for t in open_trades}

    for coin in coins:
        symbol = coin['symbol']
        if symbol in open_symbols:
            continue
        if symbol in blacklist:
            if time.time() - blacklist[symbol] < BLACKLIST_MINS * 60:
                continue
            else:
                del blacklist[symbol]

        # ═══ المرحلة 1: RSI 1m — ننتظرو التصحيح ═══
        rsi = check_rsi_1m(exchange, symbol)
        if not rsi['ok']:
            continue

        # ═══ المرحلة 2: الترند 15m + 1h ═══
        trend = check_trend(exchange, symbol)
        if not trend['ok']:
            log.info(f"📉 {symbol} RSI:{rsi['rsi']} ترند ضعيف {trend['score']}")
            continue

        # ═══ المرحلة 3: الشموع ═══
        candles = check_candles(exchange, symbol)
        if any("مشنوق" in p for p in candles['patterns']):
            log.info(f"☠️ {symbol} رجل مشنوق")
            continue

        # ═══ المرحلة 4: المقاومة ═══
        resist = check_resistance(exchange, symbol)
        if resist.get('near_resist'):
            log.info(f"⚠️ {symbol} مقاومة")
            continue

        # ═══ كلشي OK — ندخلو! ═══
        total_score = rsi['score'] + trend['score']

        log.info(
            f"✅ {symbol} [+{coin['change']:.1f}%] "
            f"RSI:{rsi['rsi']} | Trend:{trend['score']} | "
            f"Score:{total_score} | "
            f"{'Bullish 🟢' if candles['bullish'] else ''}"
        )

        return {
            "symbol": symbol,
            "price": coin['price'],
            "rsi": rsi['rsi'],
            "score": total_score,
            "strength": "STRONG" if total_score >= 100 else "NORMAL",
            "change_pct": coin['change'],
            "vol_ratio": rsi['vol_ratio'],
            "tier": coin['tier'],
            "candles": candles['patterns'],
        }

    return None
